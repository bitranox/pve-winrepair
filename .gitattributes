# Normalize every text file to LF in the repo AND the working tree, on every OS.
# `text=auto` auto-detects binary and leaves it untouched; `eol=lf` forces LF checkout
# so a Windows edit/save cannot reintroduce CRLF churn.
* text=auto eol=lf

# Runtime-critical: CRLF here breaks execution on Linux (^M in shebang / make recipes).
Makefile     text eol=lf
*.sh         text eol=lf
*.py         text eol=lf
*.ps1        text eol=lf
*.toml       text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# The packed guest tool is generated and committed: a fresh pack of the guest sources must equal it.
# The sources are pinned to LF (a CRLF checkout would pack other bytes), and the artefact is stored
# and checked out byte for byte, never converted, because its payload sha covers exact bytes.
src/pve_winrepair_guest/*.py                     text eol=lf
src/pve_winrepair/adapters/guest_tool/*.ps1      -text
